<configuration>
  <input>
    <net-file value="../1x6_8std.net.xml"/>
    <route-files value="car_weekday_11h.rou.xml,bus_weekday_11h.rou.xml,amb_weekday_11h.rou.xml"/>
  </input>
  <time>
    <begin value="0"/>
    <end value="3600"/>
  </time>
  <processing>
    <ignore-junction-blocker value="60"/>
  </processing>
  <report>
    <no-step-log value="true"/>
    <duration-log.statistics value="true"/>
  </report>
</configuration>
