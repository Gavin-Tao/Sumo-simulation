<routes>
    <!-- 车辆类型 -->
    <vType id="car" color="1,0,0"/>
    <vType id="bus" color="0,0,1"/>
    <vType id="ambulance" color="1,1,1"/>

    <!-- 路径 -->
    <route id="route_ns" edges="n_t t_s"/>
    <route id="route_sn" edges="s_t t_n"/>
    <route id="route_we" edges="w_t t_e"/>
    <route id="route_ew" edges="e_t t_w"/>
    <route id="route_en" edges="e_t t_n"/>
    <route id="route_es" edges="e_t t_s"/>
    <route id="route_wn" edges="w_t t_n"/>
    <route id="route_ws" edges="w_t t_s"/>
    <route id="route_ne" edges="n_t t_e"/>
    <route id="route_nw" edges="n_t t_w"/>
    <route id="route_sw" edges="s_t t_w"/>
    <route id="route_se" edges="s_t t_e"/>

    <!-- 东西走廊直行：bus -->
    <flow id="flow_ew_bus" route="route_ew" begin="0" end="3600" vehsPerHour="350"
          type="bus" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_we_bus" route="route_we" begin="0" end="3600" vehsPerHour="350"
          type="bus" departSpeed="max" departPos="base" departLane="best"/>

    <!-- 南北走廊直行：car (99%) + ambulance (1%)，总流量保持 350 veh/h -->
    <flow id="flow_ns_car" route="route_ns" begin="0" end="3600" vehsPerHour="346.5"
          type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_ns_amb" route="route_ns" begin="0" end="3600" period="exp(0.000972)"
          type="ambulance" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_sn_car" route="route_sn" begin="0" end="3600" vehsPerHour="346.5"
          type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_sn_amb" route="route_sn" begin="0" end="3600" period="exp(0.000972)"
          type="ambulance" departSpeed="max" departPos="base" departLane="best"/>

    <!-- 所有左转/转向：全部 car -->
    <flow id="flow_es_car" route="route_es" begin="0" end="3600" vehsPerHour="350"
          type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_wn_car" route="route_wn" begin="0" end="3600" vehsPerHour="350"
          type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_en_car" route="route_en" begin="0" end="3600" vehsPerHour="350"
          type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_ws_car" route="route_ws" begin="0" end="3600" vehsPerHour="350"
          type="car" departSpeed="max" departPos="base" departLane="best"/>

    <flow id="flow_ne_car" route="route_ne" begin="0" end="3600" vehsPerHour="350"
          type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_nw_car" route="route_nw" begin="0" end="3600" vehsPerHour="350"
          type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_sw_car" route="route_sw" begin="0" end="3600" vehsPerHour="350"
          type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_se_car" route="route_se" begin="0" end="3600" vehsPerHour="350"
          type="car" departSpeed="max" departPos="base" departLane="best"/>
</routes>
