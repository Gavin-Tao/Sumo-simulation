<routes>
    <!-- vehicle types -->
    <vType id="car" color="1,0,0"/>
    <vType id="bus" color="0,0,1"/>
    <!-- ambulance: 固定路线（route 已确定边）+ 禁用所有变道 -->
    <vType id="ambulance" color="1,1,1"
           lcStrategic="0" lcCooperative="0" lcSpeedGain="0" lcKeepRight="0"/>

    <!--
        1x3 Network topology:
          w -> [t/LEFT] <-t_e/e_t-> [e/CENTER] <-E0/-E0-> [J0/RIGHT] -> J5(east)
                  |N/S                   |J1(N),J2(S)              |J3(N),J4(S)

        Setup (与 base 不同点)：
          - WE 直行（贯通 3 路口）：99% car + 1% ambulance
          - NS 直行（每路口）   ：100% bus
          - 所有左转/转向       ：car（同 base）
    -->

    <!-- ===== E-W CORRIDOR (through all 3 intersections) ===== -->
    <!-- 99% car + 1% ambulance（总流量保持 350 veh/h） -->
    <route id="route_ew" edges="w_t t_e E0 E5"/>
    <route id="route_we" edges="-E5 -E0 e_t t_w"/>

    <flow id="flow_ew_car" route="route_ew" begin="0" end="3600" vehsPerHour="346.5"
          type="car" departSpeed="max" departPos="base" departLane="1"/>
    <flow id="flow_ew_amb" route="route_ew" begin="0" end="3600" period="exp(0.000972)"
          type="ambulance" departSpeed="max" departPos="base" departLane="1"/>
    <flow id="flow_we_car" route="route_we" begin="0" end="3600" vehsPerHour="346.5"
          type="car" departSpeed="max" departPos="base" departLane="1"/>
    <flow id="flow_we_amb" route="route_we" begin="0" end="3600" period="exp(0.000972)"
          type="ambulance" departSpeed="max" departPos="base" departLane="1"/>

    <!-- ===== N-S STRAIGHT at each intersection (bus) ===== -->
    <route id="route_ns_L" edges="n_t t_s"/>
    <route id="route_sn_L" edges="s_t t_n"/>
    <route id="route_ns_C" edges="-E1 E2"/>
    <route id="route_sn_C" edges="-E2 E1"/>
    <route id="route_ns_R" edges="-E3 E4"/>
    <route id="route_sn_R" edges="-E4 E3"/>

    <flow id="flow_ns_L_bus" route="route_ns_L" begin="0" end="3600" vehsPerHour="350" type="bus" departSpeed="max" departPos="base" departLane="1"/>
    <flow id="flow_sn_L_bus" route="route_sn_L" begin="0" end="3600" vehsPerHour="350" type="bus" departSpeed="max" departPos="base" departLane="1"/>
    <flow id="flow_ns_C_bus" route="route_ns_C" begin="0" end="3600" vehsPerHour="350" type="bus" departSpeed="max" departPos="base" departLane="1"/>
    <flow id="flow_sn_C_bus" route="route_sn_C" begin="0" end="3600" vehsPerHour="350" type="bus" departSpeed="max" departPos="base" departLane="1"/>
    <flow id="flow_ns_R_bus" route="route_ns_R" begin="0" end="3600" vehsPerHour="350" type="bus" departSpeed="max" departPos="base" departLane="1"/>
    <flow id="flow_sn_R_bus" route="route_sn_R" begin="0" end="3600" vehsPerHour="350" type="bus" departSpeed="max" departPos="base" departLane="1"/>

    <!-- ===== TURNS at LEFT (from W, N, S) — all car (unchanged) ===== -->
    <route id="route_wn_L" edges="w_t t_n"/>
    <route id="route_ws_L" edges="w_t t_s"/>
    <route id="route_nw_L" edges="n_t t_w"/>
    <route id="route_ne_L" edges="n_t t_e E1"/>
    <route id="route_sw_L" edges="s_t t_w"/>
    <route id="route_se_L" edges="s_t t_e E2"/>

    <flow id="flow_wn_L" route="route_wn_L" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="2"/>
    <flow id="flow_ws_L" route="route_ws_L" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="0"/>
    <flow id="flow_nw_L" route="route_nw_L" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="0"/>
    <flow id="flow_ne_L" route="route_ne_L" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="2"/>
    <flow id="flow_sw_L" route="route_sw_L" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="2"/>
    <flow id="flow_se_L" route="route_se_L" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="0"/>

    <!-- ===== TURNS at CENTER (from N, S) — all car (unchanged) ===== -->
    <route id="route_nw_C" edges="-E1 e_t t_n"/>
    <route id="route_ne_C" edges="-E1 E0 E3"/>
    <route id="route_sw_C" edges="-E2 e_t t_s"/>
    <route id="route_se_C" edges="-E2 E0 E4"/>

    <flow id="flow_nw_C" route="route_nw_C" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="0"/>
    <flow id="flow_ne_C" route="route_ne_C" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="2"/>
    <flow id="flow_sw_C" route="route_sw_C" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="2"/>
    <flow id="flow_se_C" route="route_se_C" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="0"/>

    <!-- ===== TURNS at RIGHT (from E, N, S) — all car (unchanged) ===== -->
    <route id="route_en_R" edges="-E5 E3"/>
    <route id="route_es_R" edges="-E5 E4"/>
    <route id="route_nw_R" edges="-E3 -E0 E1"/>
    <route id="route_ne_R" edges="-E3 E5"/>
    <route id="route_sw_R" edges="-E4 -E0 E2"/>
    <route id="route_se_R" edges="-E4 E5"/>

    <flow id="flow_en_R" route="route_en_R" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="0"/>
    <flow id="flow_es_R" route="route_es_R" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="2"/>
    <flow id="flow_nw_R" route="route_nw_R" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="0"/>
    <flow id="flow_ne_R" route="route_ne_R" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="2"/>
    <flow id="flow_sw_R" route="route_sw_R" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="2"/>
    <flow id="flow_se_R" route="route_se_R" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="0"/>

</routes>
