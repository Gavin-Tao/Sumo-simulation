<routes>
    <!-- vehicle types -->
    <vType id="car" color="1,0,0"/>
    <vType id="bus" color="0,0,1"/>

    <!-- ===== E-W CORRIDOR: 60% bus (210/h) + 40% car (140/h) ===== -->
    <route id="route_ew" edges="w_t t_e E0 E5"/>
    <route id="route_we" edges="-E5 -E0 e_t t_w"/>

    <flow id="flow_ew_bus" route="route_ew" begin="0" end="3600" vehsPerHour="210"
          type="bus" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_ew_car" route="route_ew" begin="0" end="3600" vehsPerHour="140"
          type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_we_bus" route="route_we" begin="0" end="3600" vehsPerHour="210"
          type="bus" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_we_car" route="route_we" begin="0" end="3600" vehsPerHour="140"
          type="car" departSpeed="max" departPos="base" departLane="best"/>

    <!-- ===== N-S STRAIGHT at each intersection (car) ===== -->
    <route id="route_ns_L" edges="n_t t_s"/>
    <route id="route_sn_L" edges="s_t t_n"/>
    <route id="route_ns_C" edges="-E1 E2"/>
    <route id="route_sn_C" edges="-E2 E1"/>
    <route id="route_ns_R" edges="-E3 E4"/>
    <route id="route_sn_R" edges="-E4 E3"/>

    <flow id="flow_ns_L" route="route_ns_L" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_sn_L" route="route_sn_L" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_ns_C" route="route_ns_C" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_sn_C" route="route_sn_C" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_ns_R" route="route_ns_R" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_sn_R" route="route_sn_R" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="best"/>

    <!-- ===== TURNS at LEFT (from W, N, S) ===== -->
    <route id="route_wn_L" edges="w_t t_n"/>
    <route id="route_ws_L" edges="w_t t_s"/>
    <route id="route_nw_L" edges="n_t t_w"/>
    <route id="route_ne_L" edges="n_t t_e E0 E5"/>
    <route id="route_sw_L" edges="s_t t_w"/>
    <route id="route_se_L" edges="s_t t_e E0 E5"/>

    <flow id="flow_wn_L" route="route_wn_L" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_ws_L" route="route_ws_L" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_nw_L" route="route_nw_L" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_ne_L" route="route_ne_L" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_sw_L" route="route_sw_L" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_se_L" route="route_se_L" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="best"/>

    <!-- ===== TURNS at CENTER (from N, S) ===== -->
    <route id="route_nw_C" edges="-E1 e_t t_w"/>
    <route id="route_ne_C" edges="-E1 E0 E5"/>
    <route id="route_sw_C" edges="-E2 e_t t_w"/>
    <route id="route_se_C" edges="-E2 E0 E5"/>

    <flow id="flow_nw_C" route="route_nw_C" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_ne_C" route="route_ne_C" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_sw_C" route="route_sw_C" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_se_C" route="route_se_C" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="best"/>

    <!-- ===== TURNS at RIGHT (from E, N, S) ===== -->
    <route id="route_en_R" edges="-E5 E3"/>
    <route id="route_es_R" edges="-E5 E4"/>
    <route id="route_nw_R" edges="-E3 -E0 e_t t_w"/>
    <route id="route_ne_R" edges="-E3 E5"/>
    <route id="route_sw_R" edges="-E4 -E0 e_t t_w"/>
    <route id="route_se_R" edges="-E4 E5"/>

    <flow id="flow_en_R" route="route_en_R" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_es_R" route="route_es_R" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_nw_R" route="route_nw_R" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_ne_R" route="route_ne_R" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_sw_R" route="route_sw_R" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="best"/>
    <flow id="flow_se_R" route="route_se_R" begin="0" end="3600" vehsPerHour="350" type="car" departSpeed="max" departPos="base" departLane="best"/>

</routes>
